generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String

  disciplinas AlunoDisciplina[]
}

model Disciplina {
  id Int  @id @default(autoincrement())
  nome String @unique // Assume que cada disciplina tem nome único 
  cargaHoraria Int
  semestre Int
  createdAt DateTime @default(now())

  alunos AlunoDisciplina[]
}

enum StatusMatricula {
  cursando
  aprovado
  reprovado
}

model AlunoDisciplina {
  id Int    @id @default(autoincrement())

  userId  Int
  disciplinaId  Int

  faltas  Int @default(0)
  nota    Float?

  status StatusMatricula @default(cursando)
  createdAt DateTime @default(now())

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  disciplina  Disciplina  @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  @@unique([userId,disciplinaId]) //evita duplicado
  @@index ([userId])
  @@index ([disciplinaId])
}